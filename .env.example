# 必需：全量选稿与中文写作（默认 MiniMax）
MINIMAX_API_KEY=your_minimax_api_key

# 可选：改用其他 Anthropic 兼容接口（如 DeepSeek）；设置后优先于 MINIMAX_API_KEY
# LLM_API_KEY=your_api_key
# LLM_API_URL=https://api.deepseek.com/anthropic/v1/messages
# LLM_MODEL_MAIN=deepseek-v4-pro
# LLM_MODEL_LIGHT=deepseek-flash

# 可选：日报发布通知；一旦配置，发送失败会阻断 published
# 可选：微信通知（PushPlus，https://www.pushplus.plus 扫码获取 token）；可与飞书同时配置
PUSHPLUS_TOKEN=

FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id

# 可选：Twitter 独立摘要通知；未设置时复用 FEISHU_WEBHOOK
FEISHU_TWITTER_WEBHOOK=

# 可选：qa.py --factcheck 的网页读取能力
ZHIPU_WEBREADER_TOKEN=

# 可选：覆盖默认日报时区与 06:40 截止时间
REPORT_TIMEZONE=Asia/Shanghai
REPORT_CUTOFF_HOUR=6
REPORT_CUTOFF_MINUTE=40

# 可选：邮件推送
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASSWORD=your_qq_mail_authorization_code
SMTP_SSL=true
EMAIL_RECIPIENTS=lp1@example.com,lp2@example.com
