#!/usr/bin/env python3
"""AI 前沿动态 - 行研日报"""

import feedparser
import httpx
from datetime import datetime, timezone, timedelta
from collections import defaultdict
import re
import urllib3

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# ========== 读取OPML ==========
OPML_FILE = "/Users/shenyalan/Desktop/Subscriptions-OnMyMac.opml"

def parse_opml(opml_file):
    sources = {}
    try:
        with open(opml_file, 'r', encoding='utf-8') as f:
            content = f.read()
        lines = content.split('\n')
        for line in lines:
            url_match = re.search(r'xmlUrl="([^"]+)"', line)
            title_match = re.search(r'title="([^"]+)"', line)
            if url_match and title_match:
                url = url_match.group(1)
                title = title_match.group(1)
                cn_keywords = ["36kr", "wechat", "qbitai", "xlab", "itjuzi", "juzi", "github"]
                is_cn = any(kw in url.lower() for kw in cn_keywords)
                sources[title] = (url, "CN" if is_cn else "US")
        return sources
    except Exception as e:
        print(f"❌ 读取OPML失败: {e}")
        return {}

SOURCES = parse_opml(OPML_FILE)
# 备用源（手动添加）
EXTRA_SOURCES = {
    "HuggingFace Blog": ("https://huggingface.co/blog/feed.xml", "US"),
    "Microsoft News": ("https://news.microsoft.com/source/feed/", "US"),
}
SOURCES.update(EXTRA_SOURCES)

# ========== 源优先级 ==========
# 规则：海外公司/事件→英文源优先；国内公司/事件→中文源优先
# 数字越小优先级越高
SOURCE_PRIORITY = {
    # 英文源（海外事件优先）
    "OpenAI News": 1, "Google DeepMind": 2, "NVIDIA Blog": 3,
    "Microsoft Research": 4, "Y Combinator Blog": 5, "TechCrunch": 6,
    "The Information": 7, "The Keyword": 8, "The a16z Show": 9,
    "karpathy": 10, "Sakana Blog": 11, "Thinking Machines Lab": 12,
    "Crunchbase News": 13,
    # 中文源（国内事件优先）
    "量子位": 20, "新智元": 21, "机器之心": 22, "36氪": 23,
    "IT桔子": 24, "PaperWeekly": 25,
}

# 判断是否为海外事件的关键词
OVERSEAS_KEYWORDS = ["openai", "google", "nvidia", "microsoft", "meta", "apple",
                     "amazon", "anthropic", "claude", "gpt", "gemini", "y combinator",
                     "a16z", "spacex", "tesla", "softbank", "venture", "funding round"]

# 判断是否为中国事件的关键词
CHINA_KEYWORDS = ["华为", "阿里", "字节", "百度", "腾讯", "小米", "商汤", "旷视",
                  "智谱", "月之暗面", "minimax", "阶跃星辰", "零一万物", "中国", "国产"]

def get_dynamic_priority(article):
    """根据内容动态调整优先级"""
    text = (article.get("title", "") + " " + article.get("summary", "")).lower()
    if any(kw in text for kw in OVERSEAS_KEYWORDS):
        pass
    elif any(kw in text for kw in CHINA_KEYWORDS):
        pass
    return SOURCE_PRIORITY.get(article["source"], 50)

# ========== 时间窗口 ==========
def get_time_window():
    beijing_offset = 8
    now_utc = datetime.now(timezone.utc)
    now_beijing = now_utc + timedelta(hours=beijing_offset)
    end_beijing = now_beijing.replace(hour=9, minute=0, second=0, microsecond=0)
    if now_beijing.hour < 9:
        end_beijing = end_beijing - timedelta(days=1)
    start_beijing = end_beijing - timedelta(days=1)
    return start_beijing - timedelta(hours=8), end_beijing - timedelta(hours=8), start_beijing, end_beijing

START_UTC, END_UTC, START_BJ, END_BJ = get_time_window()

# ========== 分类 ==========
# 改进：更精准的关键词，避免歧义
CATEGORIES = {
    # 模型前沿：模型名、能力关键词
    "模型前沿": ["LLM", "大模型", "GPT", "Claude", "Gemini", "Qwen", "DeepSeek", "MoE", "Transformer", "VLA", "R1", "o1", "图像生成", "视频生成", "Sora", "Veo", "世界模型", "具身智能", "benchmark", "评测", "模型", "Agent", "multimodal", "reasoning", "world model", "frontier model", "thinking model", "model"],
    # 算力追踪：硬件、芯片、云服务、定价
    "算力追踪": ["GPU", "NPU", "TPU", "H100", "H200", "B100", "Blackwell", "芯片", "算力", "定价", "价格", "token", "成本", "云计算", "AWS", "Azure", "inference", "training", "compute", "NVIDIA", "AMD", "data center", "cluster"],
    # 产业动态：产品发布、公司战略
    "产业动态": ["产品", "发布", "上线", "更新", "合作", "战略", "部署", "硬件", "机器人", "自动驾驶", "智驾", "Apple", "Meta", "Microsoft", "字节", "阿里", "百度", "腾讯", "华为", "Amazon", "launch", "release", "update", "product", "partner", "announce", "partnership"],
    # 初创&融资：融资、投资、估值、收购
    "初创&融资": ["融资", "投资", "Funding", "Round", "估值", "IPO", "收购", "并购", "亿元", "亿美元", "A轮", "B轮", "C轮", "独角兽", "funding", "raise", "acquire", "valuation", "unicorn", "series", "seed", "startup"],
    # 研究关注：论文、学术
    "研究关注": ["论文", "研究", "Nature", "ICML", "NeurIPS", "CVPR", "ACL", "arXiv", "学者", "教授", "实验室", "paper", "research", "algorithm", "preprint", "academic"],
}
CATEGORY_PRIORITY = {"模型前沿": 1, "产业动态": 2, "算力追踪": 3, "初创&融资": 4, "研究关注": 5, "其他": 6}

MAX_PER_CATEGORY = 5
OUTPUT_FILE = "daily-ai-news.md"

# ========== 工具 ==========
def clean_text(t): return re.sub(r'<[^>]+>', '', t or "").strip() if t else ""
def normalize(t): return re.sub(r'\s+', '', (t or "").lower())

def parse_date(entry):
    """解析RSS条目日期"""
    # 优先使用 feedparser 已解析的 published_parsed
    if hasattr(entry, "published_parsed") and entry.published_parsed:
        try:
            return datetime(*entry.published_parsed[:6], tzinfo=timezone.utc)
        except: pass
    # 回退：尝试手动解析
    import email.utils
    import calendar
    for f in ["published", "updated", "created"]:
        if hasattr(entry, f):
            try:
                p = email.utils.parsedate_tz(getattr(entry, f))
                if p:
                    timestamp = calendar.timegm(p[:9])
                    return datetime.fromtimestamp(timestamp, tz=timezone.utc)
            except: continue
    return None

def is_in_window(entry):
    d = parse_date(entry)
    return False if d is None else START_UTC <= d <= END_UTC

def get_cat(title, summary):
    """获取主要分类（只返回一个，避免重复）"""
    text = (title + " " + (summary or "")).lower()
    scores = {}

    # 计算每个分类的匹配分数
    for cat, keywords in CATEGORIES.items():
        score = sum(1 for k in keywords if k.lower() in text)
        if score > 0:
            scores[cat] = score

    if not scores:
        return ["其他"]

    # 按分数和优先级排序，返回最高分的分类
    sorted_cats = sorted(scores.items(), key=lambda x: (-x[1], CATEGORY_PRIORITY.get(x[0], 6)))
    return [sorted_cats[0][0]]

# ========== 相似度 ==========
def extract_keywords(title):
    t = clean_text(title).lower()
    stop_words = ["announces", "launches", "introduces", "releases", "updates", "new", "the", "a", "an", "and", "or", "for", "with", "from"]
    words = re.findall(r'\w+', t)
    return set(w for w in words if w not in stop_words and len(w) > 2)

def calc_similarity(title1, title2):
    kw1, kw2 = extract_keywords(title1), extract_keywords(title2)
    if not kw1 or not kw2: return 0
    intersection = len(kw1 & kw2)
    union = len(kw1 | kw2)
    return intersection / union if union > 0 else 0

# ========== 去重 ==========
def dedup_with_priority(articles):
    """去重：相似度>0.6视为重复，保留优先级高的"""
    unique, duplicates = [], []
    for a in articles:
        is_dup = False
        for i, u in enumerate(unique):
            if a["source"] == u["source"]:
                continue
            sim = calc_similarity(a["title"], u["title"])
            title_a, title_u = normalize(a["title"]), normalize(u["title"])
            if sim > 0.6 or title_a in title_u or title_u in title_a:
                prio_a = SOURCE_PRIORITY.get(a["source"], 50)
                prio_u = SOURCE_PRIORITY.get(u["source"], 50)
                if prio_a < prio_u:
                    duplicates.append((u["source"], a["source"], a["title"][:25]))
                    unique[i] = a
                else:
                    duplicates.append((a["source"], u["source"], u["title"][:25]))
                is_dup = True
                break
        if not is_dup:
            unique.append(a)
    return unique, duplicates

# ========== 摘要生成 ==========
def generate_summary(title, summary, cat):
    """生成摘要：完整句子，不过度截断"""
    t, s = clean_text(title), clean_text(summary)
    if not s: return f"{cat}动态"
    sentences = re.split(r'[。！？.!?]+', s)
    valid = [x.strip() for x in sentences if x.strip() and len(x.strip()) > 10]
    for sent in valid:
        if t and len(t) > 5 and t[:20].lower() in sent.lower(): continue
        keywords = ["发布", "上线", "融资", "收购", "合作", "突破", "推出", "开源", "完成", "获得", "亿元", "万美元", "首次", "最强", "提升", "launch", "release", "introduces", "announces", "billion", "million", "first", "new"]
        if any(k.lower() in sent.lower() for k in keywords):
            result = sent.strip()
            if not result.endswith('。') and not result.endswith('.'): result += "。"
            return result
    if valid:
        result = valid[0].strip()
        if not result.endswith('。') and not result.endswith('.'): result += "。"
        return result
    return f"{cat}动态"

def generate_content(title, summary):
    """生成内容：确保至少2处加粗，完整句子"""
    t, s = clean_text(title), clean_text(summary)
    if not s: return [t[:100]] if t else ["内容待补充"]

    sentences = re.split(r'[。！？.!?]+', s)
    sentences = [x.strip() for x in sentences if x.strip() and len(x.strip()) > 8]
    if not sentences: return [s[:100]] if s else ["内容待补充"]
    sentences = sentences[:6]

    important = ["突破", "首次", "最新", "发布", "融资", "亿美元", "亿元", "第一", "最强", "提升", "降低", "成本", "50x", "10x", "显著", "推出", "开源", "合作", "收购", "完成", "获得", "launch", "release", "introduces", "announces", "billion", "million", "first", "new", "unveils", "reveals", "achieves"]

    result, bold_cnt = [], 0
    for i, sent in enumerate(sentences):
        is_imp = i < 2 or any(k.lower() in sent.lower() for k in important)
        if is_imp:
            bold_cnt += 1
            result.append(f"**{sent}**")
        else:
            result.append(sent)

    if bold_cnt < 2 and len(result) >= 2:
        if "**" not in result[0]:
            result[0] = f"**{result[0]}**"
            bold_cnt += 1
        if bold_cnt < 2 and len(result) > 1 and "**" not in result[1]:
            result[1] = f"**{result[1]}**"

    return result

# ========== 抓取 ==========
def fetch_source(name, url, limit=15):
    try:
        client = httpx.Client(timeout=15, verify=False, follow_redirects=True)
        r = client.get(url, headers={"User-Agent": "Mozilla/5.0"})
        r.raise_for_status()
        feed = feedparser.parse(r.text)
        articles = []
        for e in feed.entries:
            if not is_in_window(e): continue
            title = clean_text(e.get("title", ""))
            link = e.get("link", "")
            summary = clean_text(e.get("summary") or e.get("description") or "")
            if not title or len(title) < 5: continue
            cats = get_cat(title, summary)
            articles.append({
                "title": title, "summary": generate_summary(title, summary, cats[0]),
                "content": generate_content(title, summary), "link": link,
                "categories": cats, "source": name, "priority": SOURCE_PRIORITY.get(name, 50)
            })
            if len(articles) >= limit: break
        client.close()
        return articles, None
    except Exception as e: return [], str(e)[:60]

# ========== 生成报告 ==========
def generate(articles):
    month_day = END_BJ.strftime("%m月%d日")
    by_cat = defaultdict(list)
    for a in articles:
        for c in a["categories"]: by_cat[c].append(a)
    for c in by_cat: by_cat[c] = sorted(by_cat[c], key=lambda x: CATEGORY_PRIORITY.get(c, 6))[:MAX_PER_CATEGORY]

    lines = [f"## {month_day} AI 前沿动态", "", f"> 自动汇总 | 时间窗口: 24h | 每类 Top {MAX_PER_CATEGORY}", "", "---", "", "#要点汇总#", ""]
    for cat in ["模型前沿", "产业动态", "算力追踪", "初创&融资", "研究关注", "其他"]:
        items = by_cat.get(cat, [])
        if not items: lines.append(f"- {cat}：无")
        else: lines.append(f"- {cat}：{'；'.join([a['title'][:30]+'...' if len(a['title'])>30 else a['title'] for a in items[:2]])}")

    lines.extend(["", "---", "", "#详情参考#", ""])
    for cat in ["模型前沿", "产业动态", "算力追踪", "初创&融资", "研究关注", "其他"]:
        items = by_cat.get(cat, [])
        lines.append(f"## {cat}")
        lines.append("" if items else "- 无")
        for a in items:
            summary = a["summary"]
            if summary and not summary.strip().endswith('。'): summary = summary.strip() + '。'
            lines.append(f"**{a['title']}** {summary}")
            lines.append(f"- {' '.join(a['content'])}")
            lines.append(f"- 来源：{a['link']}")
            lines.append("")
    lines.extend(["", "---", "", f"*生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M')}*"])
    return "\n".join(lines)

# ========== 主函数 ==========
def main():
    print(f"🤖 抓取AI前沿动态")
    print(f"   时间窗口: {START_BJ.strftime('%Y-%m-%d %H:%M')} - {END_BJ.strftime('%Y-%m-%d %H:%M')} 北京时间")
    print(f"   RSS源: {len(SOURCES)} 个")
    print(f"   优先级: 海外事件→英文源优先，国内事件→中文源优先")

    all_arts, errors = [], []
    for name, (url, tz) in SOURCES.items():
        print(f"  📡 {name}...", end=" ", flush=True)
        arts, err = fetch_source(name, url)
        if err: print("❌"); errors.append(f"{name}: {err}")
        else: print(f"✅ {len(arts)}"); all_arts.extend(arts)

    unique, duplicates = dedup_with_priority(all_arts)
    unique = sorted(unique, key=lambda x: (min(CATEGORY_PRIORITY.get(c, 6) for c in x["categories"]), x["priority"]))

    print(f"\n📊 {len(all_arts)} → {len(unique)} 条 (去重{len(duplicates)}条)")
    if duplicates:
        print("🔄 去重: 低优先级 → 高优先级")
        for d in duplicates[:3]: print(f"   {d[0]} → {d[1]}: {d[2]}...")

    by_cat = defaultdict(int)
    for a in unique:
        for c in a["categories"]: by_cat[c] += 1
    print(f"📂 分类: ", end="")
    for cat in ["模型前沿", "产业动态", "算力追踪", "初创&融资", "研究关注"]: print(f"{cat}{by_cat.get(cat,0)} ", end="")
    print("")
    if errors: print(f"⚠️ 失败: {errors[:3]}")

    with open(OUTPUT_FILE, "w", encoding="utf-8") as f: f.write(generate(unique))
    print(f"✅ 已输出: {OUTPUT_FILE}")

if __name__ == "__main__": main()
